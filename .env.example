EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_your_revenuecat_test_store_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_your_revenuecat_test_store_key

# Somente para o Supabase CLI local; nunca use estas chaves como EXPO_PUBLIC_*.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.example.bookroom.service
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_generated_apple_client_secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_web_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_client_secret

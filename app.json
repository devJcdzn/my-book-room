{
  "expo": {
    "name": "Bookroom",
    "slug": "my-book-room",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "scheme": "mybookroom",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF7E9"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.devjc.bookroom",
      "icon": {
        "light": "./assets/ios-light.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF7E9",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.bookroom.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDF7E9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#131520"
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/Separate_Assets_glb/Work_Table_06.glb",
            "./assets/Separate_Assets_glb/Chair_17.glb",
            "./assets/Separate_Assets_glb/Light_05.glb",
            "./assets/Separate_Assets_glb/Plants_05.glb",
            "./assets/Separate_Assets_glb/Plants_15.glb",
            "./assets/cats-assets/catnap-orange.glb",
            "./assets/cats-assets/black-catnap.glb",
            "./assets/cats-assets/gray-catnap.glb"
          ]
        }
      ],
      "expo-image",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7b7808a-d8c4-4a56-8003-ce654b9904cb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c7b7808a-d8c4-4a56-8003-ce654b9904cb"
    }
  }
}

{
  "expo": {
    "name": "Nookly",
    "description": "Sua biblioteca, no seu ritmo",
    "slug": "my-book-room",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/ios-light.png",
    "scheme": "mybookroom",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.devjc.bookroom",
      "icon": {
        "light": "./assets/ios-light.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": ["pt-BR"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Permite escolher fotos para personalizar os quadros da sua sala de leitura.",
        "NSPhotoLibraryAddUsageDescription": "Permite salvar imagens do seu refúgio de leitura no seu rolo da câmera.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ]
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FDF7E9",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.bookroom.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlayfairDisplay-Regular.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Playfair Display",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlayfairDisplay-Regular.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PlayfairDisplay-Regular.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDF7E9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FDF7E9"
          }
        }
      ],
      "expo-image",
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7b7808a-d8c4-4a56-8003-ce654b9904cb"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c7b7808a-d8c4-4a56-8003-ce654b9904cb"
    }
  }
}

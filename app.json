{
  "expo": {
    "name": "Bookroom",
    "slug": "my-book-room",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mybookroom",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bookroom.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EBDD",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.bookroom.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5EBDD"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/Separate_Assets_glb/Work_Table_06.glb",
            "./assets/Separate_Assets_glb/Chair_17.glb",
            "./assets/Separate_Assets_glb/Light_05.glb",
            "./assets/Separate_Assets_glb/Plants_05.glb",
            "./assets/Separate_Assets_glb/Plants_15.glb",
            "./assets/Separate_Assets_glb/Picture_21.glb"
          ]
        }
      ],
      "expo-image",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

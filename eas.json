{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_ACCOUNT_SYNC": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENABLE_ACCOUNT_SYNC": "true"
      }
    },
    "beta-android": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BETA_UNLOCK_ALL": "true",
        "EXPO_PUBLIC_ENABLE_ACCOUNT_SYNC": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_ACCOUNT_SYNC": "true",
        "EXPO_PUBLIC_ENABLE_ANALYTICS": "true"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810810549"
      }
    }
  }
}
